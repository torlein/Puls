{
  "name": "puls-og-blodtrykk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interaktiv forklaring av forskjellen mellom puls og blodtrykk, med 3D-modell.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "model": "node scripts/build-model.mjs",
    "test": "playwright test --trace off",
    "screenshots": "node tests/screenshots.mjs",
    "deploy": "npm run build && node scripts/make-worker.mjs && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
